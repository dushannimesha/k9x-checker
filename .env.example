# Copy to .env and fill in. Never commit .env.

# Backend's own database (inspection results, manifest cache)
DATABASE_URL=postgresql+asyncpg://k9x:CHANGE_ME@127.0.0.1:5433/k9x

# Where official manifest records come from: "mock" (seeded demo data) or "http" (real API)
MANIFEST_PROVIDER=mock
# {shipping_id} is substituted, e.g. https://api.example.com/v1/shipments/{shipping_id}
MANIFEST_API_URL=
MANIFEST_API_TOKEN=
MANIFEST_CACHE_TTL_S=300
MANIFEST_TIMEOUT_S=5

# Comma-separated keys the robot (and the dashboard test form) send as X-API-Key
ROBOT_API_KEYS=dev-robot-key

# Matching thresholds
NAME_MATCH_THRESHOLD=85
NAME_UNCERTAIN_THRESHOLD=70
WEIGHT_TOLERANCE_PCT=5
MIN_OCR_CONFIDENCE=0.6

HOST=127.0.0.1
PORT=8077
